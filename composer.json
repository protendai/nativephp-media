{
    "name": "protendai/nativephp-media",
    "description": "Media player for NativePHP Mobile on iOS and Android: background audio with lock-screen, notification and Bluetooth controls, queues, shuffle/repeat, speed, per-item resume, a full-screen video player with picture-in-picture, and opt-in device media library access.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": ["nativephp", "nativephp-plugin", "nativephp-mobile", "laravel", "media", "audio", "video", "player", "background-audio", "picture-in-picture", "media3", "avplayer", "android", "ios"],
    "homepage": "https://github.com/protendai/nativephp-media",
    "support": {
        "issues": "https://github.com/protendai/nativephp-media/issues",
        "source": "https://github.com/protendai/nativephp-media"
    },
    "authors": [
        {
            "name": "Tendai Karuma",
            "email": "karumatendai@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Protendai\\Media\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Protendai\\Media\\MediaServiceProvider"
            ],
            "aliases": {
                "Media": "Protendai\\Media\\Facades\\Media"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
